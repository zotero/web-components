{
  "name": "zotero-www-components",
  "version": "0.1.1",
  "description": "React components for zotero.org that are not the web library",
  "main": "src/js/web-components.js",
  "files": [
    "src/js",
    "src/scss",
    "build"
  ],
  "type": "module",
  "browserslist": "firefox >= 68, chrome >=67, edge >= 15, safari >= 10, last 2 versions, not dead, not ie 11, not ie 10",
  "scripts": {
    "start": "run-p 'php-server' 'esbuild-watch' 'watch:scss'",
    "php-server": "php -c demo/php.ini -S 0.0.0.0:8000 > phpd.log 2>&1 & echo \"server running at http://localhost:8000/demo/\n\"",
    "rollup-watch": "NODE_ENV=develop rollup -c -w",
    "esbuild-watch": "NODE_ENV=develop esbuild ./src/js/web-components.js --bundle --loader:.js=jsx  --sourcemap --target=chrome67,firefox68,safari14,edge79 --watch --define:global=window --outfile=./build/web-components.js",
    "prepack": "npm run build",
    "postpack": "rimraf lib && rimraf build",
    "clean": "rimraf build",
    "build": "rimraf lib/* && rimraf build/* && run-p build:node build:scss && npm run build:postprocess",
    "build-esbuild": "esbuild ./src/js/web-components.js --bundle --loader:.js=jsx --minify --sourcemap --target=chrome67,firefox68,safari14,edge79 --define:global=window --outfile=./build/web-components.js",
    "build:node": "NODE_ENV=production rollup -c",
    "build:postprocess": "postcss build/web-components.css --use autoprefixer --no-map -r",
    "build:scss": "sass --style compressed src/scss/entry_build.scss build/web-components.css",
    "devbuild:scss": "run-s devbuild:scss:build devbuild:scss:post",
    "devbuild:scss:build": "sass --style compressed src/scss/entry_build.scss build/web-components.css",
    "devbuild:scss:post": "postcss build/*.css --use autoprefixer -r",
    "watch:scss": "nodemon -q -w src/scss --ext 'scss' --exec 'npm run devbuild:scss'",
    "eslint": "eslint \"src/js/**/*.+(js|jsx)\" || true",
    "stylelint": "stylelint src/scss/**/*.scss || true",
    "test-docker": "mocha --timeout 20000 --compilers js:@babel/register --require @babel/polyfill ./test/tests/testPages.js"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-config-recommended-scss"
    ],
    "rules": {
      "max-empty-lines": null,
      "indentation": null
    }
  },
  "keywords": [
    "Zotero"
  ],
  "author": "Faolan C-P",
  "license": "AGPL-3.0",
  "devDependencies": {
    "@babel/cli": "^7.14.8",
    "@babel/eslint-parser": "^7.15.0",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-transform-async-to-generator": "^7.20.7",
    "@babel/plugin-transform-runtime": "^7.21.0",
    "@babel/preset-env": "^7.20.2",
    "@babel/preset-react": "^7.18.6",
    "@rollup/plugin-babel": "^6.0.3",
    "@rollup/plugin-commonjs": "^24.0.1",
    "@rollup/plugin-json": "^6.0.0",
    "@rollup/plugin-node-resolve": "^15.0.1",
    "@rollup/plugin-replace": "^5.0.2",
    "@rollup/plugin-terser": "^0.4.0",
    "autoprefixer": "^10.4.2",
    "chai": "^4.3.0",
    "esbuild": "0.17.19",
    "mocha": "^9.1.3",
    "nodemon": "^2.0.7",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.21",
    "postcss-cli": "^10.1.0",
    "react-radio-group": "^3.0.3",
    "rimraf": "^2.7.1",
    "rollup": "^3.20.0",
    "run-sequence": "^2.2.1",
    "sass": "^1.49.9",
    "selenium-webdriver": "^4.0.0-beta.4",
    "stylelint": "^13.13.1",
    "stylelint-config-recommended-scss": "^4.2.0",
    "stylelint-config-standard": "^20.0.0",
    "stylelint-scss": "^3.19.0"
  },
  "dependencies": {
    "@babel/runtime": "^7.21.0",
    "@babel/runtime-corejs3": "^7.21.0",
    "@stripe/react-stripe-js": "^2.1.0",
    "@stripe/stripe-js": "^1.52.0",
    "@tinymce/tinymce-react": "^4.1.0",
    "@tweenjs/tween.js": "^17.6.0",
    "@webscopeio/react-textarea-autocomplete": "^4.7.3",
    "bezier-easing": "^2.1.0",
    "bootstrap": "^4.6.2",
    "classnames": "^2.3.1",
    "core-js": "^3.29.1",
    "jquery": "^3.6.4",
    "prop-types": "^15.7.2",
    "react": "^18.2.0",
    "react-dnd": "^10.0.2",
    "react-dnd-html5-backend": "^10.0.2",
    "react-dom": "^18.2.0",
    "react-image-crop": "^11.0.5",
    "react-tabs": "^6.0.2",
    "reactstrap": "^8.10.1",
    "striptags": "^3.2.0",
    "webfontloader": "^1.6.28",
    "zotero-publications": "^0.6.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zotero/web-components.git"
  }
}
